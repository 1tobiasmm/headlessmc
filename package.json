{
  "name": "headless-balance-bot",
  "version": "0.1.0",
  "description": "Headless Minecraft bot manager that reads an account balance and reports it, controlled over a local HTTP API",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "headless-balance-bot": "src/main.js",
    "headless-balance-bot-cli": "src/cli.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test \"test/*.test.js\"",
    "probe": "node scripts/probe.js",
    "cli": "node src/cli.js",
    "auth": "node scripts/auth-login.js",
    "mock-server": "node scripts/mock-server.js",
    "bench": "node scripts/benchmark.js"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "minecraft-protocol": "^1.68.0",
    "prismarine-auth": "^3.1.1",
    "prismarine-nbt": "^2.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
